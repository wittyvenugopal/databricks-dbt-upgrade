diff --git a/dbt_project/macros/product_channel_pairs.sql b/dbt_project/macros/product_channel_pairs.sql
--- a/dbt_project/macros/product_channel_pairs.sql
+++ b/dbt_project/macros/product_channel_pairs.sql
@@ -1,8 +1,10 @@
-{# Every product x channel pair as a SELECT. V2: modules.itertools is removed - use two for loops #}
+{# Every product x channel pair as a SELECT. #}
 {% macro product_channel_pairs(products, channels) %}
     {% set rows = [] %}
-    {% for p, c in modules.itertools.product(products, channels) %}
-        {% do rows.append("select '" ~ p ~ "' as product, '" ~ c ~ "' as sales_channel") %}
+    {% for p in products %}
+        {% for c in channels %}
+            {% do rows.append("select '" ~ p ~ "' as product, '" ~ c ~ "' as sales_channel") %}
+        {% endfor %}
     {% endfor %}
     {{ return(rows | join(" union all ")) }}
 {% endmacro %}
